# Copy to .env for local development. `pnpm dev` starts Postgres and Redis
# with these credentials.
#
# process.env is read in exactly one place, packages/config, and validated
# against a Zod schema there. A missing or malformed value fails the process
# at start rather than at first use.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Pooled connection: api, edge, and every single-workspace job.
DATABASE_URL=postgres://relayd:relayd@localhost:5432/relayd

# Direct, never-pooled connection: the scheduler only (INVARIANTS R35).
# Locally these point at the same server; in production DATABASE_URL may be
# PgBouncer and this one must not be.
DATABASE_DIRECT_URL=postgres://relayd:relayd@localhost:5432/relayd

REDIS_URL=redis://localhost:6379

# Which role this process runs as: api, edge, worker or scheduler.
RELAYD_PROCESS=api

# Which worker entrypoint, when RELAYD_PROCESS=worker.
# One of: send, campaign, events, billing, io
RELAYD_WORKER_ENTRYPOINT=send
