# Line endings are normalised to LF in the repository AND in the working tree
# on every platform. This repository is developed on Windows and built on
# Linux CI and in a Linux container.
#
# Without this, the working tree depends on each developer's core.autocrlf
# setting. A shell script checked out with CRLF fails on Linux with the
# unhelpful "bad interpreter: /bin/sh^M", and the container entrypoint is a
# shell script.
* text=auto eol=lf

# Executable and container files: LF is not negotiable.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf

# Binary: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
