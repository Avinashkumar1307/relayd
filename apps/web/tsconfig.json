{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser build is Vite's job; tsc's job here is typechecking only,
    // so it emits declarations into a scratch directory and nothing else.
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/types/.tsbuildinfo",
    "emitDeclarationOnly": true,

    // Browser, not Node: the base config targets NodeNext for the services.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/types" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/validation" },
    { "path": "../../packages/audience" }
  ]
}
