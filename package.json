{
  "name": "relayd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "turbo run build",
    "typecheck": "tsc -b && tsc -p tsconfig.vitest.json",
    "lint": "eslint .",
    "test": "turbo run build && vitest run",
    "test:isolation": "bash scripts/test-isolation.sh",
    "test:contract": "bash scripts/test-contract.sh",
    "test:billing": "bash scripts/test-billing.sh",
    "db:generate": "bash scripts/db-generate.sh",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "eslint-plugin-relayd": "workspace:^",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  }
}
