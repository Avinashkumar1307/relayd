{
  "name": "relayd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "turbo run build",
    "typecheck": "tsc -b && tsc -p tsconfig.vitest.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:isolation": "bash scripts/test-isolation.sh",
    "test:contract": "bash scripts/test-contract.sh",
    "test:billing": "bash scripts/test-billing.sh",
    "db:generate": "bash scripts/db-generate.sh",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:reset": "bash scripts/db-reset.sh"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
